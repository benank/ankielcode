{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ankiel-code-site",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "code.ankiel.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "GITHUB_REPO": "benank/ankielcode",
  },
}
