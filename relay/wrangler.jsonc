{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ankiel-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOM",
        "class_name": "RelayRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"],
    },
  ],
}
