    "Addresses the computer reports, such as its local network address, are tried first and checked before any credential is sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adressen, die der Computer meldet, etwa seine Adresse im lokalen Netzwerk, werden zuerst versucht und geprüft, bevor Zugangsdaten gesendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las direcciones que informa el equipo, como su dirección de red local, se prueban primero y se verifican antes de enviar cualquier credencial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
