{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ came back still on %@. Try again, or update it on that machine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ist zurück, aber noch auf %2$@. Versuch es erneut oder aktualisiere es auf diesem Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ came back still on %2$@. Try again, or update it on that machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ volvió, pero sigue en %2$@. Inténtalo de nuevo o actualízalo en ese equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ est revenu, mais toujours en %2$@. Réessayez ou mettez-le à jour sur cette machine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ は再起動しましたが、まだ %2$@ のままです。もう一度試すか、そのマシンで更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@이(가) 다시 연결되었지만 아직 %2$@입니다. 다시 시도하거나 해당 컴퓨터에서 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ voltou, mas ainda está na %2$@. Tente novamente ou atualize nessa máquina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ снова на связи, но всё ещё на версии %2$@. Повторите попытку или обновите его на этом компьютере."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ är tillbaka men fortfarande på %2$@. Försök igen eller uppdatera på den datorn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ 已恢复，但仍是 %2$@。请重试，或在那台电脑上更新。"
          }
        }
      }
    },
    "%@ closed the connection while pairing. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hat die Verbindung während der Kopplung getrennt. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ cerró la conexión durante el emparejamiento. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ a fermé la connexion pendant l’appairage. Réessayez dans un instant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ペアリング中に %@ が接続を閉じました。少し待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "페어링 중에 %@이(가) 연결을 닫았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ fechou a conexão durante o pareamento. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ закрыл соединение во время сопряжения. Повторите попытку чуть позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ stängde anslutningen under parkopplingen. Försök igen om en stund."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 在配对过程中关闭了连接。请稍后重试。"
          }
        }
      }
    },
    "%@ did not answer." : {
      "localizations" : {
