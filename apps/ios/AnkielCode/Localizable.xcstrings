    "%@ is not a project in Ankiel Code. Add it as a project to read its change requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist kein Projekt in Ankiel Code. Füge es als Projekt hinzu, um seine Änderungsanfragen zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no es un proyecto en Ankiel Code. Agrégalo como proyecto para leer sus solicitudes de cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ n’est pas un projet dans Ankiel Code. Ajoutez-le comme projet pour lire ses demandes de modification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ は Ankiel Code のプロジェクトではありません。変更リクエストを読むにはプロジェクトとして追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) Ankiel Code의 프로젝트가 아닙니다. 변경 요청을 읽으려면 프로젝트로 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ não é um projeto no Ankiel Code. Adicione-o como projeto para ler suas solicitações de alteração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ не является проектом в Ankiel Code. Добавьте его как проект, чтобы читать его запросы на изменение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ är inte ett projekt i Ankiel Code. Lägg till det som projekt för att läsa dess ändringsförfrågningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 不是 Ankiel Code 中的项目。将其添加为项目以读取其变更请求。"
          }
        }
      }
    },
    "%@ is saved with a different address. If it moved, update it to use this one: its sign-in is replaced and the old addresses stay as fallbacks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist mit einer anderen Adresse gespeichert. Wenn er umgezogen ist, aktualisiere ihn auf diese Adresse: Die Anmeldung wird ersetzt, und die alten Adressen bleiben als Ausweichadressen erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está guardado con otra dirección. Si se ha movido, actualízalo para usar esta: se reemplaza su inicio de sesión y las direcciones anteriores quedan como alternativas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est enregistré avec une autre adresse. S’il a changé d’adresse, mettez-le à jour pour utiliser celle-ci : sa connexion est remplacée et les anciennes adresses restent en secours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ は別のアドレスで保存されています。移動した場合は、このアドレスを使うように更新してください。サインインは置き換えられ、古いアドレスは予備として残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) 다른 주소로 저장되어 있습니다. 주소가 바뀌었다면 이 주소를 사용하도록 업데이트하세요. 로그인은 교체되고 이전 주소는 대체 주소로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está salvo com outro endereço. Se ele mudou, atualize para usar este: o login é substituído e os endereços antigos ficam como alternativas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ сохранён с другим адресом. Если он переехал, обновите его на этот адрес: вход будет заменён, а старые адреса останутся запасными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ är sparad med en annan adress. Om den har flyttat kan du uppdatera den till den här: inloggningen ersätts och de gamla adresserna finns kvar som reserv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 以另一个地址保存。如果它已迁移，请更新为使用此地址：其登录信息会被替换，旧地址保留为备用。"
          }
        }
      }
    },
