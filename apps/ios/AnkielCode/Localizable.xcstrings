    "This device's sign-in to %@ expired or was revoked. Pair it again with a new pairing link from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung dieses Geräts bei %1$@ ist abgelaufen oder wurde widerrufen. Kopple es erneut mit einem neuen Kopplungslink von %2$@."
