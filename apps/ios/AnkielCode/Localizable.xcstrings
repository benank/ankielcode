    "Only pair with computers you own. It will be able to show this device its threads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kopple nur mit Computern, die dir gehören. Der Computer kann diesem Gerät dann seine Threads zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empareja solo con equipos que sean tuyos. Podrá mostrar sus hilos en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’appairez que des ordinateurs qui vous appartiennent. Il pourra afficher ses conversations sur cet appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ペアリングは自分のコンピュータとだけ行ってください。そのコンピュータのスレッドがこのデバイスに表示されるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "내가 소유한 컴퓨터와만 페어링하세요. 해당 컴퓨터의 스레드가 이 기기에 표시될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pareie apenas com computadores que são seus. Ele poderá mostrar as threads dele neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выполняйте сопряжение только со своими компьютерами. Компьютер сможет показывать этому устройству свои треды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parkoppla bara med datorer du äger. Den kommer att kunna visa sina trådar på den här enheten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只与你自己的电脑配对。配对后，它可以在此设备上显示其会话。"
          }
        }
      }
    },
