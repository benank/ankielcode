    "Nothing is listening on port %@ on %@. Start the server there, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %2$@ lauscht nichts auf Port %1$@. Starte dort den Server und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada escucha en el puerto %1$@ de %2$@. Inicia el servidor allí y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’écoute sur le port %1$@ de %2$@. Démarre le serveur là-bas, puis réessaie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ のポート %1$@ で待ち受けているものはありません。そこでサーバーを起動してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@의 포트 %1$@에서 수신 대기 중인 항목이 없습니다. 그곳에서 서버를 시작한 다음 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada está escutando na porta %1$@ de %2$@. Inicie o servidor lá e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На порту %1$@ в %2$@ ничего не слушает. Запустите там сервер и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget lyssnar på port %1$@ i %2$@. Starta servern där och försök sedan igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上的端口 %1$@ 没有任何服务在监听。请在那里启动服务器，然后再试一次。"
          }
        }
      }
    },
