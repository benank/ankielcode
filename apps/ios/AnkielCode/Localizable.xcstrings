        }
      }
    },
    "Dictation on this device needs iOS 26 or later, a supported device, and a supported language. Your keyboard’s dictation is separate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktieren auf diesem Gerät erfordert iOS 26 oder neuer, ein unterstütztes Gerät und eine unterstützte Sprache. Das Diktieren deiner Tastatur ist davon unabhängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado en este dispositivo requiere iOS 26 o posterior, un dispositivo compatible y un idioma compatible. El dictado de tu teclado es independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée sur cet appareil nécessite iOS 26 ou une version ultérieure, un appareil compatible et une langue prise en charge. La dictée de votre clavier est distincte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでの音声入力には、iOS 26 以降、対応デバイス、対応言語が必要です。キーボードの音声入力とは別のものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 받아쓰기를 사용하려면 iOS 26 이상, 지원 기기, 지원 언어가 필요합니다. 키보드의 받아쓰기와는 별개입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ditado neste dispositivo exige iOS 26 ou posterior, um dispositivo compatível e um idioma compatível. O ditado do seu teclado é separado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для диктовки на этом устройстве нужны iOS 26 или новее, поддерживаемое устройство и поддерживаемый язык. Диктовка клавиатуры работает отдельно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering på den här enheten kräver iOS 26 eller senare, en enhet som stöds och ett språk som stöds. Tangentbordets diktering är separat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此设备上听写需要 iOS 26 或更高版本、受支持的设备和受支持的语言。键盘的听写是单独的功能。"
          }
        }
      }
    },
