          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'둘 다'는 사용 가능한 경우 세션과 주간을 표시합니다. 잠금 화면에는 선택한 한도 중 가장 빠듯한 것이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
