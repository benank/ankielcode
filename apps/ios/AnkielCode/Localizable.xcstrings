    "This redeems one credit on your account and clears the current rate-limit windows. It cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird ein Guthaben auf deinem Konto eingelöst und die aktuellen Rate-Limit-Zeitfenster werden zurückgesetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto canjea un crédito de tu cuenta y borra las ventanas de límite de uso actuales. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela utilise un crédit de votre compte et efface les fenêtres de limite de débit actuelles. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントのクレジットを 1 件使用し、現在のレート制限の期間をクリアします。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정의 크레딧 1개를 사용해 현재 속도 제한 기간을 초기화합니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso usa um crédito da sua conta e limpa as janelas de limite de taxa atuais. Não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет списан один кредит с вашего аккаунта, а текущие окна ограничения запросов будут сброшены. Это действие нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här löser in en kredit på ditt konto och nollställer de aktuella fönstren för hastighetsbegränsning. Det går inte att ångra."
          }
        },
        "zh-Hans" : {
