        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera définitivement supprimé, y compris l’historique de son terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はターミナルの履歴を含めて完全に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
