    "Follow and steer the coding agents on your own computers, from anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verfolge und lenke die Coding-Agenten auf deinen eigenen Computern – von überall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sigue y dirige los agentes de programación de tus propios equipos, desde cualquier lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suivez et pilotez les agents de code de vos propres ordinateurs, où que vous soyez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自分のコンピュータで動くコーディングエージェントを、どこからでも確認して指示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "내 컴퓨터의 코딩 에이전트를 어디서나 확인하고 조정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acompanhe e direcione os agentes de programação dos seus próprios computadores, de qualquer lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Следите за агентами программирования на своих компьютерах и управляйте ими откуда угодно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Följ och styr kodagenterna på dina egna datorer, var du än är."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
