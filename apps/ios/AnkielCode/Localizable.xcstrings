    "It tries again by itself, or resume it now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie versucht es von selbst erneut, oder setze sie jetzt fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo reintenta sola, o reanúdala ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle réessaie d’elle-même, ou reprenez-la maintenant."
          }
