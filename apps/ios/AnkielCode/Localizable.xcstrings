        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de este dispositivo en %1$@ caducó o fue revocado. Emparéjalo de nuevo con un enlace de emparejamiento nuevo de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion de cet appareil à %1$@ a expiré ou a été révoquée. Appairez-le à nouveau avec un nouveau lien d’appairage depuis %2$@."
