    "This action will commit and push changes on \"%@\". You can continue on this branch or create a feature branch and run the same action there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aktion committet und pusht Änderungen auf „%@“. Du kannst auf diesem Branch weitermachen oder einen Feature-Branch erstellen und dieselbe Aktion dort ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción hará commit y push de los cambios en \"%@\". Puedes continuar en esta rama o crear una rama de funcionalidad y ejecutar allí la misma acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action va commiter et pousser les modifications sur « %@ ». Vous pouvez continuer sur cette branche ou créer une branche de fonctionnalité et y lancer la même action."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は \"%@\" 上の変更をコミットしてプッシュします。このブランチで続行するか、機能ブランチを作成してそこで同じ操作を実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 \"%@\"에 변경 사항을 커밋하고 푸시합니다. 이 브랜치에서 계속하거나 기능 브랜치를 만들어 같은 작업을 실행할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação vai fazer commit e push das alterações em \"%@\". Você pode continuar neste branch ou criar um branch de feature e executar a mesma ação nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет выполнен коммит и пуш изменений в «%@». Можно продолжить в этой ветке или создать feature-ветку и выполнить то же действие там."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här åtgärden committar och pushar ändringar på ”%@”. Du kan fortsätta på den här grenen eller skapa en funktionsgren och köra samma åtgärd där."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将在“%@”上提交并推送更改。你可以继续使用此分支，或创建功能分支并在其上执行相同操作。"
          }
        }
      }
    },
