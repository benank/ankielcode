          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Все поля ввода будут очищены, а вложения удалены. Неотправленные сообщения сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
