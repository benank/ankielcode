    "Snooze threads until their usage limits reset. Enable auto-resume to continue the agent after the reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Threads zurückstellen, bis ihre Nutzungslimits zurückgesetzt werden. Aktiviere automatisches Fortsetzen, damit der Agent nach dem Zurücksetzen weiterarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pospone los hilos hasta que se restablezcan sus límites de uso. Activa la reanudación automática para que el agente continúe tras el restablecimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporte les fils jusqu’à la réinitialisation de leurs limites d’utilisation. Activez la reprise automatique pour que l’agent continue après la réinitialisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用量の上限がリセットされるまでスレッドをスヌーズします。リセット後にエージェントを続行するには、自動再開を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용량 한도가 초기화될 때까지 스레드를 미룹니다. 초기화 후 에이전트를 계속하려면 자동 재개를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adia as threads até os limites de uso delas serem redefinidos. Ative a retomada automática para continuar o agente após a redefinição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откладывать треды до сброса лимитов использования. Включите автовозобновление, чтобы агент продолжил после сброса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snooza trådar tills deras användningsgränser återställs. Aktivera automatisk återupptagning för att fortsätta agenten efter återställningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将会话暂缓到用量限制重置。开启自动继续后，智能体会在重置后接着工作。"
          }
        }
      }
    },
