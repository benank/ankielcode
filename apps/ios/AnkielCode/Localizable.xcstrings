    "%@ runs a version of Ankiel Code that can't open its localhost pages on this device. Update it there, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ läuft eine Ankiel-Code-Version, die ihre localhost-Seiten nicht auf diesem Gerät öffnen kann. Aktualisiere sie dort und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ejecuta una versión de Ankiel Code que no puede abrir sus páginas de localhost en este dispositivo. Actualízala allí y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exécute une version de Ankiel Code qui ne peut pas ouvrir ses pages localhost sur cet appareil. Mettez-la à jour là-bas, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ で実行中の Ankiel Code は、この端末で localhost ページを開けないバージョンです。そちらで更新してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 실행 중인 Ankiel Code 버전은 이 기기에서 localhost 페이지를 열 수 없습니다. 그곳에서 업데이트한 후 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ executa uma versão do Ankiel Code que não consegue abrir as páginas de localhost dele neste dispositivo. Atualize-o lá e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На %@ работает версия Ankiel Code, которая не может открывать свои страницы localhost на этом устройстве. Обновите её там и попробуйте снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kör en version av Ankiel Code som inte kan öppna sina localhost-sidor på den här enheten. Uppdatera den där och försök sedan igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 运行的 Ankiel Code 版本无法在此设备上打开其 localhost 页面。请在那里更新后重试。"
          }
        }
      }
    },
