    "Pages on %@’s localhost load through its connection. Try again once it reconnects." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten auf dem localhost von %@ laden über dessen Verbindung. Versuche es erneut, sobald die Verbindung wieder steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas del localhost de %@ se cargan a través de su conexión. Vuelve a intentarlo cuando se reconecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages du localhost de %@ passent par sa connexion. Réessaie une fois la connexion rétablie."
