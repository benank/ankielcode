        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の localhost のページは、その接続を通じて読み込まれます。再接続されたらもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 localhost 페이지는 해당 연결을 통해 로드됩니다. 다시 연결되면 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
