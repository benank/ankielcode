        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto vacía todos los cuadros de mensaje y quita sus adjuntos. Los mensajes sin enviar se mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
