    "Connect %@ to manage it. These are the values it reported when it was last connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbinde %@, um ihn zu verwalten. Das sind die Werte, die er bei der letzten Verbindung gemeldet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecta %@ para administrarlo. Estos son los valores que informó la última vez que estuvo conectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connectez %@ pour le gérer. Voici les valeurs qu’il a signalées lors de sa dernière connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "管理するには %@ を接続してください。これは最後に接続していたときに報告された値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "관리하려면 %@을(를) 연결하세요. 마지막으로 연결되었을 때 보고된 값입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecte %@ para gerenciá-lo. Estes são os valores que ele informou na última vez em que esteve conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подключите %@, чтобы управлять им. Это значения, которые он сообщил при последнем подключении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anslut %@ för att hantera den. Det här är värdena den rapporterade när den senast var ansluten."
