<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ankiel.ankielcode.native</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ankielcode-native</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ankiel Code uses the microphone when you dictate a message. Speech is transcribed on this device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ankiel Code saves images you choose to your photo library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Ankiel Code transcribes your dictation on this device.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.ankiel.ankielcode.pair-environment</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>Geist_400Regular.ttf</string>
		<string>Geist_500Medium.ttf</string>
		<string>Geist_600SemiBold.ttf</string>
		<string>Geist_700Bold.ttf</string>
		<string>GeistMono_400Regular.ttf</string>
		<string>GeistMono_400Regular_Italic.ttf</string>
		<string>GeistMono_500Medium.ttf</string>
		<string>GeistMono_600SemiBold.ttf</string>
		<string>GeistMono_700Bold.ttf</string>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Ankiel Code Pairing Invite</string>
			<key>UTTypeIdentifier</key>
			<string>com.ankiel.ankielcode.pairing-invite</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ankielpair</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.ankielcode.pairing-invite+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
